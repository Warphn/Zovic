meta {
  name: Pôr a foto do artista
  type: http
  seq: 13
}

put {
  url: {{baseUrl}}/api/admin/artists/{{artistId}}/image
  body: multipartForm
  auth: none
}

headers {
  Origin: {{origin}}
}

body:multipart-form {
  image: @file(fixtures/capa.png)
}

tests {
  test("responde 200 com a foto", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().hasImage).to.equal(true);
  });
}
