meta {
  name: Pôr música repetida
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/playlists/{{playlistId}}/musics
  body: json
  auth: none
}

body:json {
  {
    "musicId": {{musicA}}
  }
}

tests {
  test("responde 409: a música já está na playlist", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().error).to.equal("BUSINESS_RULE_ERROR");
  });
}
