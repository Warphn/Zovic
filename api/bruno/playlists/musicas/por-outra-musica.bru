meta {
  name: Pôr outra música no fim
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/playlists/{{playlistId}}/musics
  body: json
  auth: none
}

body:json {
  {
    "musicId": {{musicB}}
  }
}

tests {
  test("responde 201 com a música nova no fim", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().map((m) => m.id)).to.deep.equal([bru.getVar("musicA"), bru.getVar("musicB")]);
  });
}
