meta {
  name: Sem cookie de sessão
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/playlists
  body: json
  auth: none
}

body:json {
  {
    "name": "Rock"
  }
}

tests {
  test("responde 401 sem o cookie zovic.session_token", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().error).to.equal("UNAUTHENTICATED");
  });
}
