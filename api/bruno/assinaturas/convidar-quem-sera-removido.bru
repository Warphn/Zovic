meta {
  name: Convidar (quem vai ser removido)
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/plans/me/invitations
  body: json
  auth: none
}

body:json {
  {
    "email": "{{removedEmail}}"
  }
}

script:pre-request {
  bru.setVar("removedEmail", `removido+${Date.now()}@zovic.test`);
}

script:post-response {
  bru.setVar("removedToken", res.getBody().token);
  bru.setVar("removedInvitationId", res.getBody().id);
}

tests {
  test("responde 201 com o token do link", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().token).to.be.a("string");
  });
}
