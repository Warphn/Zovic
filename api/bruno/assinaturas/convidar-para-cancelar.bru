meta {
  name: Convidar (para cancelar)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/plans/me/invitations
  body: json
  auth: none
}

body:json {
  {
    "email": "{{canceledEmail}}"
  }
}

script:pre-request {
  bru.setVar("canceledEmail", `cancelado+${Date.now()}@zovic.test`);
}

script:post-response {
  bru.setVar("canceledToken", res.getBody().token);
  bru.setVar("canceledInvitationId", res.getBody().id);
}

tests {
  test("responde 201 com o token do link", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().token).to.be.a("string");
  });
}
