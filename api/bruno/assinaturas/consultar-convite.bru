meta {
  name: Consultar o convite (público)
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/invitations/{{leaverToken}}
  body: none
  auth: none
}

tests {
  test("responde 200 com o email e o nome do gestor, sem o token", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().email).to.equal(bru.getVar("leaverEmail"));
    expect(res.getBody().managerName).to.be.a("string");
    expect(res.getBody()).to.not.have.property("token");
  });
}
