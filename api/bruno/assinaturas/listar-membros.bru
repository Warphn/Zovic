meta {
  name: Listar membros (gestor sozinho)
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/plans/me/members
  body: none
  auth: none
}

tests {
  test("responde 200 com 1 de 4 vagas ocupadas", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().members).to.have.length(1);
    expect(res.getBody().limit).to.equal(4);
    expect(res.getBody().freeSlots).to.equal(3);
  });
}
