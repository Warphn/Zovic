meta {
  name: Cadastro (conta sem plano)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/sign-up/email
  body: json
  auth: none
}

headers {
  Origin: {{origin}}
}

body:json {
  {
    "name": "Assinante Bruno",
    "email": "{{uniqueEmail}}",
    "password": "senha-do-bruno",
    "birthdate": "2000-01-31"
  }
}

script:pre-request {
  bru.setVar("uniqueEmail", `assinante+${Date.now()}@zovic.test`);
}

tests {
  test("responde 200 e abre a sessão", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
