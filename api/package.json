{
  "name": "zovic-api",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --env-file=../.env --watch infra/server.ts",
    "test": "bun test domain",
    "test:integration": "bun test --env-file=../.env adapters",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:sync": "bun scripts/db-sync.ts",
    "db:seed": "bun prisma/seed/index.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "joi": "^18.2.9",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prisma": "^7.10.0",
    "typescript": "^7"
  }
}
