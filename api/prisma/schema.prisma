// Zovic — schema Prisma, gerado por `bun run db:sync` a partir do banco.
//
// A estrutura do banco é do Flyway (db/migrations): não use `prisma migrate` nem
// `db push`. Depois de uma migration nova, rode `bun run db:sync`.
//
// db:sync preserva. Comentários `//` são apagados a cada sync.
//
// Ficam só no SQL, porque o Prisma não os representa: os CHECKs (preço >= 0,
// rating 1..5, streams >= 0, cor #RRGGBB, linha única de system_data…).
//
// previewFeatures "partialIndexes": representa os índices únicos parciais
// (WHERE deleted_at IS NULL) de genre.name e rating.

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model PlanType {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  price      Decimal   @db.Decimal(10, 2)
  userAmount Int       @map("user_amount")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  plans      Plan[]

  @@map("plan_type")
}

model Plan {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(100)
  typeId    Int        @map("type_id")
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  type      PlanType   @relation(fields: [typeId], references: [id], onUpdate: NoAction)
  users     PlanUser[]

  @@index([typeId])
  @@map("plan")
}

model PlanUser {
  planId  Int     @map("plan_id")
  userId  Int     @map("user_id")
  isAdmin Boolean @default(false) @map("is_admin")
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([planId, userId])
  @@index([userId])
  @@map("plan_user")
}

model User {
  id          Int            @id @default(autoincrement())
  name        String         @db.VarChar(150)
  birthdate   DateTime?      @db.Date
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  comments    Comment[]
  savedMusics MusicUser[]
  plans       PlanUser[]
  playlists   PlaylistUser[]
  ratings     Rating[]
  events      UserEvent[]

  @@map("user")
}

model UserEvent {
  id        Int           @id @default(autoincrement())
  userId    Int           @map("user_id")
  eventType UserEventType @map("event_type")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt])
  @@map("user_event")
}

model SystemData {
  singleton Boolean  @id @default(true)
  users     Int      @default(0)
  songs     Int      @default(0)
  playlists Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("system_data")
}

model Music {
  id        Int             @id @default(autoincrement())
  name      String          @db.VarChar(255)
  duration  Int
  lyricsId  Int?            @map("lyrics_id")
  streams   Int             @default(0)
  rating    Float?
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime?       @map("deleted_at") @db.Timestamptz(6)
  albums    AlbumMusic[]
  artists   ArtistMusic[]
  comments  Comment[]
  genres    GenreMusic[]
  playlists MusicPlaylist[]
  savedBy   MusicUser[]
  ratings   Rating[]

  @@map("musics")
}

model Genre {
  id        Int          @id @default(autoincrement())
  name      String       @unique(where: raw("(deleted_at IS NULL)")) @db.VarChar(100)
  color     String       @db.Char(7)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz(6)
  albums    AlbumGenre[]
  musics    GenreMusic[]

  @@map("genre")
}

model GenreMusic {
  genreId Int   @map("genre_id")
  musicId Int   @map("music_id")
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  music   Music @relation(fields: [musicId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([genreId, musicId])
  @@index([musicId])
  @@map("genre_music")
}

model Album {
  id        Int           @id @default(autoincrement())
  name      String        @db.VarChar(255)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(6)
  artists   AlbumArtist[]
  genres    AlbumGenre[]
  musics    AlbumMusic[]

  @@map("album")
}

model AlbumGenre {
  genreId Int   @map("genre_id")
  albumId Int   @map("album_id")
  album   Album @relation(fields: [albumId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([genreId, albumId])
  @@index([albumId])
  @@map("album_genre")
}

model AlbumMusic {
  albumId Int   @map("album_id")
  musicId Int   @map("music_id")
  album   Album @relation(fields: [albumId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  music   Music @relation(fields: [musicId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([albumId, musicId])
  @@index([musicId])
  @@map("album_music")
}

model Artist {
  id        Int           @id @default(autoincrement())
  name      String        @db.VarChar(255)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(6)
  albums    AlbumArtist[]
  musics    ArtistMusic[]

  @@map("artist")
}

model AlbumArtist {
  albumId  Int    @map("album_id")
  artistId Int    @map("artist_id")
  album    Album  @relation(fields: [albumId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([albumId, artistId])
  @@index([artistId])
  @@map("album_artist")
}

model ArtistMusic {
  artistId Int    @map("artist_id")
  musicId  Int    @map("music_id")
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  music    Music  @relation(fields: [musicId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([artistId, musicId])
  @@index([musicId])
  @@map("artist_music")
}

model MusicUser {
  musicId   Int       @map("music_id")
  userId    Int       @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  music     Music     @relation(fields: [musicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([musicId, userId])
  @@index([userId])
  @@map("music_user")
}

model Rating {
  id        Int       @id @default(autoincrement())
  musicId   Int       @map("music_id")
  userId    Int       @map("user_id")
  rating    Int       @db.SmallInt
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  music     Music     @relation(fields: [musicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([musicId, userId], where: raw("(deleted_at IS NULL)"))
  @@index([userId])
  @@map("rating")
}

model Comment {
  id        Int       @id @default(autoincrement())
  musicId   Int       @map("music_id")
  userId    Int       @map("user_id")
  comment   String
  timestamp Int?
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  music     Music     @relation(fields: [musicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([musicId])
  @@index([userId])
  @@map("comments")
}

model Playlist {
  id        Int             @id @default(autoincrement())
  name      String          @db.VarChar(150)
  isPrivate Boolean         @default(false) @map("is_private")
  color     String?         @db.Char(7)
  deletedAt DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  musics    MusicPlaylist[]
  users     PlaylistUser[]

  @@map("playlists")
}

model PlaylistUser {
  playlistId Int      @map("playlist_id")
  userId     Int      @map("user_id")
  isAdmin    Boolean  @default(false) @map("is_admin")
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([playlistId, userId])
  @@index([userId])
  @@map("playlist_user")
}

model MusicPlaylist {
  musicId    Int      @map("music_id")
  playlistId Int      @map("playlist_id")
  music      Music    @relation(fields: [musicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([musicId, playlistId])
  @@index([playlistId])
  @@map("music_playlist")
}

enum UserEventType {
  sign_up
  login
  logout
  music_play
  music_skip

  @@map("user_event_type")
}
