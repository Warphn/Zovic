# Postgres — consumido pelo serviço db do compose
POSTGRES_USER=zovic
POSTGRES_PASSWORD=zovic
POSTGRES_DB=zovic

# API — o DATABASE_URL também é lido pelo Prisma CLI (api/prisma.config.ts)
DATABASE_URL=postgres://zovic:zovic@localhost:5432/zovic
PORT=3333
# Origens do frontend (separadas por vírgula) autorizadas a chamar a API com o cookie de sessão
CORS_ORIGIN=http://localhost:3000

# Better Auth (autenticação). O segredo assina o cookie de sessão: precisa de 32+ caracteres.
# O valor abaixo é só para desenvolvimento; em produção gere um segredo forte
# (openssl rand -base64 32) e nunca o versione.
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# URL pública da API, sem o /api/auth
BETTER_AUTH_URL=http://localhost:3333

# Cookie de sessão: "secure" fica ligado se a variável faltar; só "false" desliga.
# Use false em desenvolvimento local (http). Em produção (https) deixe ligado.
COOKIE_SECURE=false
# Atrás de proxy reverso, número de proxies confiáveis (inteiro >= 1) para o
# rate limit enxergar o IP real. Deixe vazio/ausente se a API for exposta direto.
# No servidor, atrás do Cloudflare Tunnel, use 1.
# TRUST_PROXY=1

# Cloudflare Tunnel (profile prod). Só no .env do servidor, nunca versionar.
CLOUDFLARE_TUNNEL_TOKEN=
